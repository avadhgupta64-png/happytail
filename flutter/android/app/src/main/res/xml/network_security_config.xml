<?xml version="1.0" encoding="utf-8"?>
<!-- Only HTTPS allowed in production. localhost cleartext is allowed for
     local development builds. Remove the domain-config block before release
     if you never test on-device with a local server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow localhost cleartext for developer testing only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
